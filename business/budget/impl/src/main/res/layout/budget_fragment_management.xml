<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/budget_page_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context="com.budget.ui.BudgetManagementFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/budget_page_horizontal_margin"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/budget_page_horizontal_margin"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/budget_page_title"
                android:textColor="@color/budget_page_text_primary"
                android:textSize="@dimen/budget_page_title_size"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/budget_page_more_description"
                android:padding="6dp"
                android:src="@drawable/budget_page_ic_more" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/budget_page_background"
            app:cardCornerRadius="@dimen/budget_page_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/budget_page_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="206dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.uikit.chart.view.WalletDonutChartView
                        android:id="@+id/budget_chart"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:contentDescription="@string/budget_page_chart_description"
                        android:importantForAccessibility="yes"
                        app:walletChartAnimationDuration="300"
                        app:walletChartInteractive="false"
                        app:walletChartNoDataText="@string/budget_page_chart_no_data"
                        app:walletChartShowLegend="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/budget_page_monthly_budget"
                            android:textColor="@color/budget_page_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/budget_total_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/budget_page_monthly_budget_amount"
                            android:textColor="@color/budget_page_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/budget_page_border" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/budget_page_used"
                            android:textColor="@color/budget_page_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/budget_used_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/budget_page_used_amount"
                            android:textColor="@color/budget_page_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/budget_page_border" />

                        <TextView
                            android:id="@+id/budget_remaining_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/budget_page_remaining"
                            android:textColor="@color/budget_page_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/budget_page_remaining_amount"
                            android:textColor="@color/budget_page_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/budget_page_bg_status"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/budget_page_ic_shield" />

                    <TextView
                        android:id="@+id/budget_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/budget_page_status"
                        android:textColor="@color/budget_page_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="304dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/budget_page_background"
            app:cardCornerRadius="@dimen/budget_page_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/budget_page_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/budget_page_food_icon_description"
                        android:src="@drawable/budget_page_ic_food" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/budget_page_food"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/budget_food_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/budget_page_food_amount"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/budget_food_progress"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="9dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/budget_page_primary"
                            app:trackColor="@color/budget_page_track"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/budget_food_ratio"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="@string/budget_page_food_ratio"
                        android:textColor="@color/budget_page_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/budget_page_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/budget_page_traffic_icon_description"
                        android:src="@drawable/budget_page_ic_traffic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/budget_page_traffic"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/budget_traffic_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/budget_page_traffic_amount"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/budget_traffic_progress"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="9dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/budget_page_primary"
                            app:trackColor="@color/budget_page_track"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/budget_traffic_ratio"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="@string/budget_page_traffic_ratio"
                        android:textColor="@color/budget_page_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/budget_page_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/budget_page_shopping_icon_description"
                        android:src="@drawable/budget_page_ic_shopping" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/budget_page_shopping"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/budget_shopping_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/budget_page_shopping_amount"
                                android:textColor="@color/budget_page_text_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/budget_shopping_progress"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="9dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/budget_page_primary"
                            app:trackColor="@color/budget_page_track"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/budget_shopping_ratio"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="@string/budget_page_shopping_ratio"
                        android:textColor="@color/budget_page_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/budget_set_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/budget_page_bg_button"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/budget_page_set_budget"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/budget_page_background"
            app:cardCornerRadius="@dimen/budget_page_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/budget_page_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/budget_page_overrun_reminder"
                    android:textColor="@color/budget_page_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/budget_reminder_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="@string/budget_page_overrun_reminder" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
