<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_page_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/profile_page_horizontal_margin"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/profile_page_horizontal_margin"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/profile_about_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_page_back"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/profile_page_ic_chevron" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/profile_about_title"
            android:textColor="@color/profile_page_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="44dp"
        android:contentDescription="@string/profile_about_app_name"
        android:padding="6dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:text="@string/profile_about_app_name"
        android:textColor="@color/profile_page_text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/profile_about_slogan"
        android:textColor="@color/profile_page_text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/profile_about_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/profile_about_version"
        android:textColor="@color/profile_page_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/profile_page_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_about_privacy_entry"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:drawableEnd="@drawable/profile_page_ic_chevron"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/profile_about_privacy"
                android:textColor="@color/profile_page_text_primary"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/profile_page_divider" />

            <TextView
                android:id="@+id/profile_about_agreement_entry"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:drawableEnd="@drawable/profile_page_ic_chevron"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/profile_about_agreement"
                android:textColor="@color/profile_page_text_primary"
                android:textSize="16sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/profile_about_copyright"
        android:textColor="@color/profile_page_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
