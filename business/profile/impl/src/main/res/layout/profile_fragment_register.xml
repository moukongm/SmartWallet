<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_auth_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context="com.profile.ui.RegisterFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/profile_auth_horizontal_margin"
        android:paddingTop="@dimen/profile_auth_content_top_margin"
        android:paddingEnd="@dimen/profile_auth_horizontal_margin"
        android:paddingBottom="50dp">

        <TextView
            android:id="@+id/profile_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/profile_auth_register_title"
            android:textColor="@color/profile_auth_text_primary"
            android:textSize="@dimen/profile_auth_title_size"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_register_account_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_auth_field_height"
            android:layout_marginTop="40dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/profile_auth_input_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/profile_ic_account"
            app:startIconTint="@color/profile_auth_icon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_register_account_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/profile_auth_account_hint"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/profile_auth_text_primary"
                android:textColorHint="@color/profile_auth_hint"
                android:textSize="@dimen/profile_auth_body_size" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_register_password_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_auth_field_height"
            android:layout_marginTop="@dimen/profile_auth_field_spacing"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/profile_auth_input_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/profile_auth_icon"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/profile_ic_lock"
            app:startIconTint="@color/profile_auth_icon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_register_password_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/profile_auth_password_create_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/profile_auth_text_primary"
                android:textColorHint="@color/profile_auth_hint"
                android:textSize="@dimen/profile_auth_body_size" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_register_password_confirm_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_auth_field_height"
            android:layout_marginTop="@dimen/profile_auth_field_spacing"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/profile_auth_input_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/profile_auth_icon"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/profile_ic_lock"
            app:startIconTint="@color/profile_auth_icon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_register_password_confirm_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/profile_auth_password_confirm_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/profile_auth_text_primary"
                android:textColorHint="@color/profile_auth_hint"
                android:textSize="@dimen/profile_auth_body_size" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/profile_register_agreement_checkbox"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:buttonTint="@color/profile_auth_checkbox_tint"
                android:checked="true"
                android:padding="2dp" />

            <TextView
                android:id="@+id/profile_register_agreement_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/profile_auth_agreement"
                android:textColor="@color/profile_auth_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/profile_register_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_auth_button_height"
            android:layout_marginTop="32dp"
            android:background="@drawable/profile_bg_auth_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/profile_auth_register_action"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/profile_auth_body_size"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
