<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_page_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/profile_page_horizontal_margin"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/profile_page_horizontal_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/profile_files_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_page_back"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/profile_page_ic_chevron" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/profile_files_title"
            android:textColor="@color/profile_page_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_files_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            tools:listitem="@layout/profile_item_file" />

        <TextView
            android:id="@+id/profile_files_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/profile_page_ic_folder"
            android:drawablePadding="16dp"
            android:gravity="center"
            android:text="@string/profile_files_empty"
            android:textColor="@color/profile_page_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/profile_files_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
