<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_page_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/profile_page_horizontal_margin"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/profile_page_horizontal_margin"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/profile_backup_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_page_back"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/profile_page_ic_chevron" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/profile_backup_title"
            android:textColor="@color/profile_page_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/profile_page_ic_backup" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/profile_backup_description"
        android:textColor="@color/profile_page_text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_backup_export_button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="36dp"
        android:text="@string/profile_backup_export"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/profile_page_primary"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_backup_import_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:text="@string/profile_backup_import"
        android:textColor="@color/profile_page_primary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/profile_page_primary" />

    <TextView
        android:id="@+id/profile_backup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/profile_backup_status_idle"
        android:textColor="@color/profile_page_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/profile_backup_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:indicatorColor="@color/profile_page_primary"
        app:trackColor="@color/profile_page_divider" />

</LinearLayout>
